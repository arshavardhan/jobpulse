# Agent Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/jobs.db

# LLM Keys (Optional - The agent automatically switches to high-accuracy offline heuristic/NLP mode if unconfigured)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Scraping Settings
SCRAPER_TIMEOUT=15
MAX_JOBS_PER_SOURCE=30
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
